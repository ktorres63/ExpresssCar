---
import PhotoSlot from '../ui/PhotoSlot.astro';
import { vehicleCategoryLabels, type Vehicle } from '../../data/vehicles';
import { site } from '../../data/site';

interface Props {
	vehicle: Vehicle;
}

const { vehicle } = Astro.props;
---

<article class="flex flex-col bg-white">
	<PhotoSlot
		src={vehicle.image}
		alt={vehicle.alt}
		placeholder="Fotografía pendiente"
		class="aspect-[16/10] w-full"
	/>
	<div class="flex flex-1 flex-col gap-3 border-t-2 border-brand-red p-6">
		<p class="text-xs font-bold uppercase tracking-[0.15em] text-steel">
			{vehicleCategoryLabels[vehicle.category]}
		</p>
		<h3 class="text-xl font-bold">{vehicle.name}</h3>
		{
			!vehicle.confirmed && (
				<p class="w-fit bg-charcoal px-2 py-1 text-xs font-semibold text-white">
					Datos pendientes de confirmar
				</p>
			)
		}
		{
			(vehicle.passengers !== undefined || vehicle.luggage !== undefined) && (
				<dl class="grid grid-cols-2 gap-2 text-sm">
					{vehicle.passengers !== undefined && (
						<>
							<dt class="text-steel">Pasajeros</dt>
							<dd class="font-semibold">{vehicle.passengers}</dd>
						</>
					)}
					{vehicle.luggage !== undefined && (
						<>
							<dt class="text-steel">Equipaje</dt>
							<dd class="font-semibold">{vehicle.luggage}</dd>
						</>
					)}
				</dl>
			)
		}
		{
			vehicle.features && vehicle.features.length > 0 && (
				<ul class="flex flex-wrap gap-2 text-sm text-charcoal">
					{vehicle.features.map((feature) => (
						<li class="bg-mist px-3 py-1">{feature}</li>
					))}
				</ul>
			)
		}
		<a
			href={site.quoteHref}
			class="mt-auto pt-4 text-sm font-bold uppercase tracking-wide text-charcoal underline decoration-brand-red decoration-2 underline-offset-8 transition-colors duration-200 hover:text-brand-red"
		>
			Pedir cotización de este vehículo
		</a>
	</div>
</article>
