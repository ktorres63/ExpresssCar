---
import { MessageCircle, Phone, Mail } from '@lucide/astro';
import { contactDetails } from '../../data/site';

const quoteMessage = encodeURIComponent('Hola, quisiera solicitar una cotización de transporte.');

const channels = [
	{
		label: 'WhatsApp',
		value: contactDetails.whatsapp,
		href: contactDetails.whatsapp
			? `https://wa.me/${contactDetails.whatsapp}?text=${quoteMessage}`
			: null,
		icon: MessageCircle,
		pending: 'Número pendiente de confirmar',
	},
	{
		label: 'Teléfono',
		value: contactDetails.phone,
		href: contactDetails.phone ? `tel:+${contactDetails.phone}` : null,
		icon: Phone,
		pending: 'Número pendiente de confirmar',
	},
	{
		label: 'Correo',
		value: contactDetails.email,
		href: contactDetails.email ? `mailto:${contactDetails.email}` : null,
		icon: Mail,
		pending: 'Correo pendiente de confirmar',
	},
];

const requestDetails = [
	'Tipo de servicio que necesitas',
	'Fecha y hora del servicio',
	'Origen y destino, si aplica',
	'Número de pasajeros',
];
---

<section id="contacto" class="bg-charcoal text-white">
	<div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-2 lg:gap-20 lg:px-8 lg:py-28">
		<div>
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-red">Contacto</p>
			<h2 class="mt-3 text-3xl font-black sm:text-4xl">Solicita tu cotización</h2>
			<p class="mt-6 text-lg leading-relaxed text-white/85">
				Escríbenos o llámanos con los datos de tu viaje. Revisaremos tu solicitud y te contactaremos para
				confirmar disponibilidad y detalles. Tu solicitud no equivale a una reserva confirmada.
			</p>

			<h3 class="mt-10 text-base font-bold">Incluye en tu mensaje</h3>
			<ul class="mt-4 grid gap-2 text-white/85">
				{requestDetails.map((detail) => <li class="border-l-2 border-brand-red pl-4">{detail}</li>)}
			</ul>
		</div>

		<ul class="flex flex-col divide-y divide-white/15 border-y border-white/15 self-start">
			{
				channels.map((channel) => (
					<li class="flex items-center gap-5 py-6">
						<span class="flex size-12 shrink-0 items-center justify-center bg-brand-red">
							<channel.icon aria-hidden="true" />
						</span>
						<div class="min-w-0">
							<p class="text-sm font-bold uppercase tracking-wide text-white/70">{channel.label}</p>
							{channel.href && channel.value ? (
								<a
									href={channel.href}
									class="mt-1 block break-all text-lg font-semibold text-white underline decoration-brand-red decoration-2 underline-offset-4 transition-colors duration-200 hover:text-white/80"
								>
									{channel.value}
								</a>
							) : (
								<p class="mt-1 text-base font-semibold text-white/85">[{channel.pending}]</p>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
