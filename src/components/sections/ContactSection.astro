---
import { ArrowRight, MessageCircle, Phone, Mail } from '@lucide/astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { contactDetails } from '../../data/site';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const quoteMessage = encodeURIComponent(t.contact.whatsappMessage);

const whatsappHref = contactDetails.whatsapp
	? `https://wa.me/${contactDetails.whatsapp}?text=${quoteMessage}`
	: null;

const channels = [
	{
		label: t.contact.channels.whatsapp.label,
		value: contactDetails.whatsapp,
		href: whatsappHref,
		icon: MessageCircle,
		pending: t.contact.channels.whatsapp.pending,
	},
	{
		label: t.contact.channels.phone.label,
		value: contactDetails.phone,
		href: contactDetails.phone ? `tel:+${contactDetails.phone}` : null,
		icon: Phone,
		pending: t.contact.channels.phone.pending,
	},
	{
		label: t.contact.channels.email.label,
		value: contactDetails.email,
		href: contactDetails.email ? `mailto:${contactDetails.email}` : null,
		icon: Mail,
		pending: t.contact.channels.email.pending,
	},
];

const requestDetails = t.contact.details;
---

<section id="contacto" class="bg-charcoal text-white">
	<div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-2 lg:gap-20 lg:px-8 lg:py-28">
		<div>
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-red">{t.contact.kicker}</p>
			<h2 class="mt-3 text-3xl sm:text-4xl">{t.contact.title}</h2>
			<p class="mt-6 text-lg leading-relaxed text-white/85">
				{t.contact.description}
			</p>

			<h3 class="mt-10 text-base">{t.contact.includeTitle}</h3>
			<ul class="mt-4 grid gap-2 text-white/85">
				{requestDetails.map((detail) => <li class="border-l-2 border-brand-red pl-4">{detail}</li>)}
			</ul>

			<div class="mt-10">
				{
					whatsappHref ? (
						<>
							<ButtonLink
								href={whatsappHref}
								variant="primary"
								target="_blank"
								rel="noopener noreferrer"
								class="group w-full px-10 py-5 text-base! inset-ring-1 inset-ring-white/25 sm:w-auto sm:text-lg!"
							>
								{t.contact.cta}
								<ArrowRight
									size={20}
									aria-hidden="true"
									class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
								/>
							</ButtonLink>
							<p class="mt-3 text-sm text-white/70">
								{t.contact.whatsappNote}
							</p>
						</>
					) : (
						<>
							<button
								type="button"
								disabled
								class="inline-flex min-h-12 w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-linear-to-br from-brand-red/40 to-brand-red-dark/40 px-10 py-5 text-base font-bold uppercase tracking-wide text-white/75 inset-ring-1 inset-ring-white/15 sm:w-auto sm:text-lg"
							>
								{t.contact.cta}
								<ArrowRight size={20} aria-hidden="true" />
							</button>
							<p class="mt-3 text-sm text-white/70">{t.contact.whatsappPending}</p>
						</>
					)
				}
			</div>
		</div>

		<ul class="flex flex-col divide-y divide-white/15 border-y border-white/15 self-start">
			{
				channels.map((channel) => (
					<li class="flex items-center gap-5 py-6">
						<span class="flex size-12 shrink-0 items-center justify-center bg-brand-red">
							<channel.icon aria-hidden="true" />
						</span>
						<div class="min-w-0">
							<p class="text-sm font-bold uppercase tracking-wide text-white/70">{channel.label}</p>
							{channel.href && channel.value ? (
								<a
									href={channel.href}
									class="mt-1 block break-all text-lg font-semibold text-white underline decoration-brand-red decoration-2 underline-offset-4 transition-colors duration-200 hover:text-white/80"
								>
									{channel.value}
								</a>
							) : (
								<p class="mt-1 text-base font-semibold text-white/85">[{channel.pending}]</p>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
