---
import VehicleCard from '../fleet/VehicleCard.astro';
import { vehicles } from '../../data/vehicles';
---

<section id="flota" class="bg-mist">
	<div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
		<div class="max-w-2xl">
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-red">Flota</p>
			<h2 class="mt-3 text-3xl font-black sm:text-4xl">Vehículos para cada tipo de viaje</h2>
			<p class="mt-4 text-lg leading-relaxed text-steel">
				Desde SUVs hasta minibuses para traslados privados, viajes de turismo y grupos.
			</p>
		</div>

		<div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{vehicles.map((vehicle) => <VehicleCard vehicle={vehicle} />)}
		</div>
	</div>
</section>
