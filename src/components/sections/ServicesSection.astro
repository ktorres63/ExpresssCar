---
import { ArrowUpRight } from '@lucide/astro';
import { services } from '../../data/services';
import { site, siteImages } from '../../data/site';
---

<section id="servicios" class="bg-white">
	<div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-12 lg:gap-16 lg:px-8 lg:py-28">
		<div class="lg:col-span-5">
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-red">Servicios</p>
			<h2 class="mt-3 text-3xl font-black sm:text-4xl">Transporte privado para cada necesidad</h2>

			<figure class="mt-8">
				<img
					src={siteImages.services}
					alt="Pasajero trabajando con una laptop y hablando por teléfono en el asiento trasero de un vehículo"
					width="4032"
					height="2268"
					loading="lazy"
					decoding="async"
					class="aspect-[4/3] w-full object-cover object-center lg:aspect-[3/4]"
				/>
			</figure>
		</div>

		<ul class="border-t border-charcoal/10 lg:col-span-6 lg:col-start-7">
			{
				services.map((service, index) => (
					<li>
						<a
							href={site.quoteHref}
							class="group grid grid-cols-[2rem_1fr] items-start gap-x-4 border-b border-charcoal/10 py-6"
						>
							<span class="pt-1 text-sm font-bold text-brand-red">
								{String(index + 1).padStart(2, '0')}
							</span>
							<div>
								<h3 class="text-lg font-bold tracking-tight transition-colors duration-200 group-hover:text-brand-red sm:text-xl">
									{service.title}
								</h3>
								<p class="mt-2 leading-relaxed text-steel">{service.description}</p>
								<span class="mt-4 inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-charcoal underline decoration-brand-red decoration-2 underline-offset-8 transition-colors duration-200 group-hover:text-brand-red">
									Solicitar cotización
									<ArrowUpRight size={14} aria-hidden="true" />
								</span>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
