---
import { services } from '../../data/services';
import { site } from '../../data/site';
---

<section id="servicios" class="bg-white">
	<div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
		<div class="max-w-2xl">
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-red">Servicios</p>
			<h2 class="mt-3 text-3xl font-black sm:text-4xl">Transporte privado para cada necesidad</h2>
		</div>

		<div class="mt-14 grid gap-px bg-mist md:grid-cols-2 lg:grid-cols-3">
			{
				services.map((service) => (
					<article class="flex flex-col gap-4 bg-white p-8">
						<h3 class="text-xl font-bold">{service.title}</h3>
						<p class="leading-relaxed text-steel">{service.description}</p>
						<a
							href={site.quoteHref}
							class="mt-auto pt-2 text-sm font-bold uppercase tracking-wide text-charcoal underline decoration-brand-red decoration-2 underline-offset-8 transition-colors duration-200 hover:text-brand-red"
						>
							Solicitar cotización
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
