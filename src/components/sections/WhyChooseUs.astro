---
const reasons = [
	{
		title: 'Atención personalizada',
		description: 'Adaptamos el servicio a tu viaje: tipo de vehículo, número de pasajeros y horario.',
	},
	{
		title: 'Coordinación con anticipación',
		description: 'Revisamos cada solicitud antes de confirmar fecha, vehículo y detalles del servicio.',
	},
	{
		title: 'Para distintos tipos de cliente',
		description: 'Viajeros de negocios, turistas, empresas, familias y grupos que necesitan transporte privado.',
	},
	{
		title: 'Confirmación directa',
		description:
			'Te contactamos para validar los detalles. Una consulta no se considera reserva confirmada hasta ese momento.',
	},
];
---

<section id="nosotros" class="bg-charcoal text-white">
	<div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
		<div class="max-w-2xl">
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-red">Nosotros</p>
			<h2 class="mt-3 text-3xl font-black sm:text-4xl">¿Por qué elegir G&amp;L CAR EXPRESS?</h2>
		</div>

		<div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			{
				reasons.map((reason, index) => (
					<article class="border-t-2 border-brand-red pt-6">
						<p class="text-sm font-bold text-white/60">{String(index + 1).padStart(2, '0')}</p>
						<h3 class="mt-3 text-lg font-bold">{reason.title}</h3>
						<p class="mt-3 leading-relaxed text-white/80">{reason.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
