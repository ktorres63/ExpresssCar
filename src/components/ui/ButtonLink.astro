---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'outline-light' | 'outline-dark';
}

const { variant = 'primary', class: className, ...rest } = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-brand-red text-white hover:bg-brand-red-dark',
  'outline-light': 'border-2 border-white text-white hover:bg-white hover:text-charcoal',
  'outline-dark': 'border-2 border-charcoal text-charcoal hover:bg-charcoal hover:text-white',
};
---

<a
  class:list={[
    'inline-flex min-h-12 items-center justify-center gap-2 px-6 py-3 text-sm font-bold uppercase tracking-wide transition-colors duration-200',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
